rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pointId', 'status', 'note', 'clientTime', 'createdAt', 'uid'])
        && request.resource.data.pointId is string
        && request.resource.data.pointId in ['wp-academic-32', 'wp-library', 'wp-sports', 'wp-hostel', 'wp-robo']
        && request.resource.data.status in ['available', 'unavailable', 'dirty']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 180
        && request.resource.data.clientTime is int
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
